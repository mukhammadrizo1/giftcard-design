{
  "name": "giftcard-backend",
  "version": "1.0.0",
  "description": "High-performance vector PDF giftcard generator and Telegram bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:backend": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/assets && cp -r src/assets/* dist/assets/",
    "start": "node dist/index.js",
    "test:pdf": "tsx src/tests/testPdf.ts",
    "test:api": "tsx src/tests/testApi.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "@types/pdfkit": "^0.13.9",
    "bwip-js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fontkit": "^2.0.4",
    "grammy": "^1.34.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
