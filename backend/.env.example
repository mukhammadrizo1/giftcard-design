# Port for backend Express API
PORT=3000

# Telegram Bot Token from @BotFather (leave blank if running API only)
BOT_TOKEN=

# Node Environment
NODE_ENV=development

# Allowed CORS Origins (* for all or https://your-frontend.vercel.app)
CORS_ORIGIN=*

# Keep-alive Ping URL for 24/7 uptime on free hosts like Render (e.g. https://your-backend.onrender.com)
PING_URL=
